{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/result.js": {
      "includeFiles": "data/{general,stories}/*.js"
    },
    "api/points.js": {
      "includeFiles": "data/{general,stories}/*.js"
    },
    "api/push.js": {
      "includeFiles": "data/{general,stories}/*.js"
    }
  },
  "crons": [
    {
      "path": "/api/push?cron=daily",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/push?cron=recap",
      "schedule": "5 19 * * *"
    }
  ]
}
